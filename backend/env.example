NODE_ENV=development
PORT=4000

# MongoDB connection strings
MONGODB_URI=mongodb://localhost:27017/codecraftecom
MONGODB_URI_TEST=mongodb://localhost:27017/codecraftecom_test

# JWT configuration
JWT_ACCESS_SECRET=replace-with-32-char-access-secret
JWT_REFRESH_SECRET=replace-with-32-char-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password reset token secret
PASSWORD_RESET_TOKEN_SECRET=replace-with-password-reset-secret
PASSWORD_RESET_TOKEN_EXPIRY=1h

# CORS
CLIENT_URL=http://localhost:5173

# Stripe (placeholder)
STRIPE_SECRET_KEY=sk_test_XXX
STRIPE_WEBHOOK_SECRET=whsec_XXX

# File upload
UPLOAD_DIR=storage/uploads
